# Where the BorrowBox API runs (npm run api). Copy this file to .env.local.
# To see every state, add a test switch after /api:
#   http://localhost:4000/api/delay/3000   loading
#   http://localhost:4000/api/fail/500     error
#   http://localhost:4000/api/empty        no items
API_BASE_URL=http://localhost:4000/api
